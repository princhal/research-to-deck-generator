# --- Required ---
ANTHROPIC_API_KEY=
VOYAGE_API_KEY=

# --- Databases (local defaults match docker-compose.yml) ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/research_deck
REDIS_URL=redis://localhost:6379

# --- Optional ---
# Joins OpenAlex's "polite pool" for higher rate limits and priority support.
# No key required either way — this is just a contact email, per OpenAlex's
# own convention (https://docs.openalex.org/how-to-use-the-api/rate-limits-and-authentication).
OPENALEX_MAILTO=

# claude-sonnet-5 | claude-opus-5 | claude-haiku-4-5-20251001
ANTHROPIC_MODEL=claude-sonnet-5

# Where generated .pptx files are written. Local disk only — swap for
# object storage (S3/R2/Supabase Storage) before deploying. See README.
DECK_OUTPUT_DIR=./generated
