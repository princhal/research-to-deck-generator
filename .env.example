# --- Required ---
ANTHROPIC_API_KEY=
VOYAGE_API_KEY=

# --- Databases (local defaults match docker-compose.yml) ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/research_deck
REDIS_URL=redis://localhost:6379

# --- Optional ---
# Joins OpenAlex's "polite pool" for higher rate limits and priority support.
# No key required either way — this is just a contact email, per OpenAlex's
# own convention (https://docs.openalex.org/how-to-use-the-api/rate-limits-and-authentication).
OPENALEX_MAILTO=

# claude-sonnet-5 | claude-opus-5 | claude-haiku-4-5-20251001
ANTHROPIC_MODEL=claude-sonnet-5

# Where generate_deck.py writes the .pptx before it's uploaded to R2
# (local scratch space only, not the final storage location).
DECK_OUTPUT_DIR=./generated

# --- Object storage (Cloudflare R2) ---
# The worker and the API run on separate hosts, so the generated .pptx is
# uploaded to R2 after assembly; the download route redirects to a signed
# URL. See README "Deployment".
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
